# Antigravity Healthcare Foundation Environment Configuration (Placeholder template)
# DO NOT COMMIT REAL KEYS OR PASSWORDS

# AI Execution Mode: 'auto' (live if key configured, fallback to mock on error), 'mock' (force deterministic mock), 'live' (strict provider only)
AI_MODE=auto

# Quick toggle to enforce mock AI regardless of keys
USE_MOCK_AI=false

# AI Provider configuration: 'gemini' | 'openai' | 'anthropic' | 'custom'
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash

# Provider API Keys (Server-side ONLY; NEVER prefix with NEXT_PUBLIC_)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/healthcareapp
